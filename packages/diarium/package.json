    "agent",
    "agent-memory",
    "journal",
    "tamper-evident",
    "ed25519",
    "provenance"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ust-protocol": "^1.0.0-rc.50"
  },
  "repository": {
    "type": "git",
