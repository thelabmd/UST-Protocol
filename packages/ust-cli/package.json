{
  "name": "@ust-protocol/cli",
  "version": "1.0.0-rc.103",
  "description": "The reference `ust` CLI for UST (Universal State Transcript) 1.0 — verify a transcript, print canonical bytes for cross-language diffing, and run the HIGH genesis ceremony. One entrypoint; the Go binary reproduces this surface.",
  "author": "THE LAB (https://thelab.md)",
  "type": "module",
  "bin": {
    "ust": "index.mjs"
  },
  "files": [
    "index.mjs",
    "LICENSE",
    "README.md",
    "index.d.ts",
    "seal_mini_square.txt"
  ],
  "keywords": [
    "ust",
    "cli",
    "verify",
    "genesis",
    "trust-infrastructure"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ust-protocol/rekor-verify": "^1.0.0-rc.28",
    "@ust-protocol/web-signer": "^1.0.0-rc.25",
    "ust-protocol": "^1.0.0-rc.69",
    "@ust-protocol/ots-verify": "^1.0.0-rc.34"
  },
  "peerDependencies": {
    "wrangler": "*"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelabmd/UST-Protocol.git",
    "directory": "packages/ust-cli"
  },
  "homepage": "https://github.com/thelabmd/UST-Protocol/tree/main/packages/ust-cli#readme",
  "bugs": "https://github.com/thelabmd/UST-Protocol/issues",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    }
  },
  "types": "index.d.ts"
}
