{
  "name": "ust",
  "version": "1.0.0-rc.67",
  "private": true,
  "description": "UST (Universal State Transcript) — specification, conformance vectors, and reference implementations. Trust infrastructure for machine-readable state.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/ust-protocol",
    "packages/ust-mcp",
    "packages/ust-web-signer",
    "packages/ust-cli",
    "packages/ust-light",
    "packages/ust-ots-verify",
    "packages/ust-rekor-verify",
    "packages/diarium",
    "packages/ust-operator"
  ],
  "scripts": {
    "test": "node packages/ust-protocol/conformance.mjs && node packages/ust-protocol/run-arc-vectors.mjs",
    "test:cli": "node packages/ust-cli/regression.mjs",
    "test:printed": "node tools/printed-command-gate.mjs",
    "test:reachable": "node tools/command-reachability-gate.mjs",
    "test:model": "node packages/ust-protocol/model-correspondence.mjs",
    "test:model-lockstep": "node packages/ust-protocol/conformance.mjs > /dev/null && git diff --exit-code vectors/conformance-checks.json && node tools/model-lockstep-gate.mjs",
    "test:model-domain": "node tools/model-domain-totality.mjs",
    "test:vacuity": "node tools/vacuity-battery.mjs",
    "test:retired": "node tools/retired-mechanisms-gate.mjs",
    "test:vectors": "node packages/ust-protocol/gen-arc-vectors.mjs && git diff --exit-code vectors/arc-vectors.json && node packages/ust-protocol/run-arc-vectors.mjs",
    "test:spec-sync": "node tools/gen-spec-registry.mjs && node tools/gen-readme-version.mjs && node tools/gen-status-svg.mjs && node tools/gen-readme-panels.mjs && node tools/gen-conformance-badge.mjs && git diff --exit-code spec/UST-1.0.md README.md package.json .github/status.svg '.github/ust-*.svg' && node tools/spec-code-sync.mjs",
    "test:parity": "node tools/capability-parity.mjs",
    "test:docs-parity": "node tools/docs-verifier-parity.mjs",
    "test:light": "node packages/ust-light/test.mjs",
    "test:artwork": "node tools/gen-light-svgs.mjs && node tools/light-variant-gate.mjs",
    "test:security": "node packages/ust-protocol/security-regression.mjs",
    "test:ssrf": "node packages/ust-protocol/ssrf.test.mjs && node packages/ust-mcp/ssrf-guard.test.mjs",
    "test:drift-guards": "node packages/ust-protocol/drift-guards.test.mjs",
    "test:module-seam": "node packages/ust-protocol/module-seam-totality.test.mjs",
    "test:rule-lockstep": "node tools/rule-lockstep.mjs",
    "test:connectors": "node packages/ust-ots-verify/index.test.mjs && node packages/ust-rekor-verify/index.test.mjs",
    "test:web-signer": "node packages/ust-web-signer/test.mjs",
    "test:mcp-live": "node packages/ust-mcp/live-test.mjs",
    "test:audit": "npm audit --omit=dev --omit=optional --audit-level=critical",
    "test:changelog": "node tools/changelog-rev-gate.mjs",
    "test:ladder": "node tools/ladder-completeness-gate.mjs",
    "test:ceremony": "node tools/ceremony-selfcheck-gate.mjs",
    "test:offline": "node tools/offline-ceremony-gate.mjs",
    "test:genesis-surface": "node tools/genesis-surface-gate.mjs",
    "test:deploy": "node tools/deploy-completeness-gate.mjs",
    "test:artifact-origin": "node tools/artifact-origin-gate.mjs",
    "test:byte-vectors": "node packages/ust-protocol/gen-byte-vectors.mjs && git diff --exit-code vectors/checker-byte-vectors.json vectors/checker-security-manifest.json && node packages/ust-protocol/run-byte-vectors.mjs",
    "test:reference-checker": "node packages/ust-protocol/reference-checker.test.mjs",
    "test:reference-checker-fuzz": "node packages/ust-protocol/reference-checker.fuzz.mjs",
    "test:bmc": "node packages/ust-protocol/bmc.mjs",
    "test:temporal-bmc": "node packages/ust-protocol/temporal-bmc.mjs",
    "test:diarium": "node --test packages/diarium/test/*.test.mjs",
    "test:diary": "node tools/diarium-render.mjs --check",
    "test:recap": "node tools/recap-render.mjs --check",
    "test:keyop": "node tools/keyop-contract-gate.mjs",
    "test:assurance-map": "node tools/assurance-map-gate.mjs",
    "test:display": "node tools/display-safety-gate.mjs",
    "test:packages": "node tools/package-enumeration-gate.mjs",
    "test:root": "node tools/root-inventory-gate.mjs",
    "test:ustid": "node tools/ustid-tier-gate.mjs",
    "test:attribution": "node tools/verdict-attribution-gate.mjs",
    "test:inclusion": "node tools/inclusion-connector-gate.mjs",
    "test:cadence": "node tools/cadence-discovery-gate.mjs",
    "test:serving": "node tools/discovery-serving-gate.mjs",
    "test:consumption": "node tools/stream-consumption-gate.mjs",
    "test:report-shape": "node tools/report-shape-gate.mjs",
    "test:cadence-parity": "node tools/cadence-parity-gate.mjs",
    "test:stream-parity": "node tools/stream-parity-gate.mjs",
    "test:primitive-parity": "node tools/primitive-parity-gate.mjs",
    "test:vocabulary": "node tools/verdict-vocabulary-gate.mjs",
    "ci:local": "node tools/run-ci-locally.mjs",
    "test:unbounded-index": "node tools/unbounded-index-gate.mjs",
    "test:version-truth": "node tools/version-truth-gate.mjs",
    "types": "node tools/gen-types.mjs",
    "test:types-parity": "node tools/types-parity-gate.mjs",
    "test:ambiguous-terms": "node tools/ambiguous-term-gate.mjs",
    "test:package-contents": "node tools/package-contents-gate.mjs",
    "test:floors": "node tools/dependency-floor-gate.mjs",
    "test:probe": "node tools/consumer-probe-gate.mjs",
    "test:examples": "node tools/worked-example-gate.mjs",
    "test:protocol-name": "node tools/protocol-name-gate.mjs",
    "test:record-closure": "node tools/record-closure-gate.mjs",
    "test:remedy-guard": "node tools/remedy-guard-gate.mjs"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
